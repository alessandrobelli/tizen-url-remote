{
  "name": "tizen-url-remote",
  "version": "1.2.0",
  "description": "TizenBrew module: show a URL chosen via Telegram on a Samsung TV and switch it live",
  "appName": "TV URL Remote",
  "packageType": "mods",
  "websiteURL": "https://alessandrobelli.github.io/tizen-url-remote/",
  "main": "docs/tvurl.js",
  "keys": ["MediaPlayPause", "MediaPlay", "MediaPause", "MediaFastForward", "MediaRewind"],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check:es5": "acorn --ecma5 --silent docs/tvurl.js && acorn --ecma5 --silent docs/launcher.js",
    "serve:test": "node test/manual/serve.mjs"
  },
  "devDependencies": {
    "acorn": "8.14.0"
  }
}
