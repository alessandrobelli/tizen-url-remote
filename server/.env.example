# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Your numeric chat ID. Messages from any other chat are ignored
# (and logged as "Ignoring message from chat <id>", handy to find yours).
TELEGRAM_CHAT_ID=123456789

# Shared secret the TV sends as "Authorization: Bearer <token>". Min 16 chars.
# Generate one on the Docker host:  openssl rand -hex 12
# You type it once on the TV, so hex (0-9a-f) keeps the remote keyboard easy.
API_TOKEN=replace-with-a-long-random-string

# Optional: URL to show before the first /url command.
INITIAL_URL=
